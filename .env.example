# 复制本文件为 .env，然后把占位值改成你自己的（.env 不会提交到 git）
# 数据库连接（Prisma 使用），格式：postgresql://用户:密码@主机:端口/库名
DATABASE_URL="postgresql://manager:改成你的密码@localhost:5433/manager?schema=public"

# Docker 启动 PostgreSQL 时使用（与上面的用户名/密码保持一致）
POSTGRES_USER="manager"
POSTGRES_PASSWORD="改成你的密码"
POSTGRES_DB="manager"

# 会话签名密钥：用 `openssl rand -hex 32` 生成一段随机字符串填进来
SESSION_SECRET=""

# seed 脚本创建老板账号用的初始密码（老板首次登录后会被强制修改）
SEED_BOSS_PASSWORD=""
