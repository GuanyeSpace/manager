# 复制本文件为 .env，然后把占位值改成你自己的（.env 不会提交到 git）
# 数据库连接（Prisma 使用），格式：postgresql://用户:密码@主机:端口/库名
DATABASE_URL="postgresql://manager:改成你的密码@localhost:5433/manager?schema=public"

# Docker 启动 PostgreSQL 时使用（与上面的用户名/密码保持一致）
POSTGRES_USER="manager"
POSTGRES_PASSWORD="改成你的密码"
POSTGRES_DB="manager"

# 会话签名密钥：用 `openssl rand -hex 32` 生成一段随机字符串填进来
SESSION_SECRET=""

# seed 脚本创建老板账号用的初始密码（老板首次登录后会被强制修改）
SEED_BOSS_PASSWORD=""

# 测试账号统一密码（仅本地开发用，可留空）
TEST_ACCOUNTS_PASSWORD=""

# 是否信任反向代理覆盖的 x-forwarded-for / x-real-ip（用于登录限流的真实客户端 IP）
# 本地直连或未配置可信反向代理时保持 false；生产环境必须配合反向代理覆盖转发头并禁止直连应用端口
TRUST_PROXY="false"

# 隔离测试库（仅破坏性测试使用，库名必须以 _test 结尾；缺失时测试直接退出）
TEST_DATABASE_URL="postgresql://manager:改成你的密码@localhost:5433/manager_test?schema=public"
# 破坏性测试许可：只有显式设为 true 才允许测试连接并清理数据
ALLOW_TEST_DESTRUCTION="false"
